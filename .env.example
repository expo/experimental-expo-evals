# Local credentials. Never commit real values.
ANTHROPIC_API_KEY=
EXPO_TOKEN=
E2B_API_KEY=
TYPESAFE_API_KEY=

# Only needed when selecting Codex as the evaluated agent.
OPENAI_API_KEY=

# Shared editor bot: GitHub App installed only on the eval repository,
# with repository Contents read/write permission. App ID or client ID works.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Paste the downloaded PEM in a double-quoted multiline value.
GITHUB_APP_PRIVATE_KEY=

# Optional alternative to app credentials: a fine-grained personal token
# restricted to the eval repository with Contents read/write permission.
GITHUB_TOKEN=

# Shared dashboard login. Generate a strong password and a random session secret.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Deployment setup only. Never upload this as a Worker runtime secret.
# Expo account: Access Apps and Policies Write, Access Organizations Read.
CF_ACCESS_API_TOKEN=

# Disable Harbor telemetry for these experiments.
HARBOR_TELEMETRY=0
