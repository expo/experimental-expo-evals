# Local credentials. Never commit real values.
# Claude Code: subscription token from `claude setup-token`, or an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Set to 1 with a token to prefer subscription usage over the API key.
CLAUDE_FORCE_OAUTH=0
ANTHROPIC_API_KEY=
EXPO_TOKEN=
E2B_API_KEY=
TYPESAFE_API_KEY=

# Optional Codex agent.
OPENAI_API_KEY=
# Or a dedicated ChatGPT login file. Use an absolute path; Harbor reads it natively.
CODEX_AUTH_JSON_PATH=

# EAS Workflows production project and credentials (uses EXPO_TOKEN above).
EAS_PROJECT_ID=
# EAS Workflows staging uses its own project and token; no production fallback.
EXPO_TOKEN_STAGING=
EAS_PROJECT_ID_STAGING=

HARBOR_TELEMETRY=0
