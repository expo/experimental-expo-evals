{
  "name": "eas-evals-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:typegen": "wrangler types",
    "seed:sync": "node scripts/sync-seed.mjs",
    "dev:secrets": "node scripts/local-secrets.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "dotenv": "^17.2.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "smol-toml": "^1.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "wrangler": "^4.139.0"
  }
}
